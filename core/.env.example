# Shade Core — шаблон. python -m app.setup создаст .env с локальным ключом и правами 600.
SHADE_API_KEY=
DB_URL=sqlite+aiosqlite:///./shade.db

# Уведомления: хранение 1..365 дней; список доверенных служебных приложений (JSON).
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_ALLOWED_APPS=["ru.ozon.app.android","com.wildberries.ru","ru.yandex.taxi"]

# Home Assistant
HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_TIMEOUT_SECONDS=5

# Журнал команд и локальные служебные логи (без параметров/текстов).
EVENT_RETENTION_DAYS=90
LOG_DIR=./logs
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

# Локальная LLM: выключена по умолчанию; подготовка — scripts/download_model.sh.
LLM_ENABLED=false
LLM_MODEL_PATH=./models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LLM_CONTEXT_SIZE=1024
LLM_THREADS=2
LLM_MAX_TOKENS=128
# RLIMIT_AS дочернего процесса (виртуальная память), НЕ лимит RSS всей системы.
LLM_MEMORY_LIMIT_MB=2304
LLM_LOAD_TIMEOUT_SECONDS=120
LLM_INFERENCE_TIMEOUT_SECONDS=30

# Телеметрия HA: пустой список отключает сбор. Только числовые sensor и binary_sensor.
# Например: ["sensor.room_temperature","binary_sensor.hall_motion"]
HA_TELEMETRY_ENTITIES=[]
SENSOR_RETENTION_DAYS=90
SENSOR_HISTORY_MAX_ROWS=100000

# Очередь обработки: diagnostic проверяет конвейер БЕЗ анализа текста/LLM.
NOTIFICATION_PROCESSOR=disabled
# Относительные даты считаются от timestamp уведомления в этом часовом поясе IANA.
NOTIFICATION_TIMEZONE=Asia/Yekaterinburg
NOTIFICATION_QUEUE_SIZE=64
NOTIFICATION_PROCESSING_TIMEOUT_SECONDS=30
NOTIFICATION_SHUTDOWN_SECONDS=5

# TASK-20: только явно выбранный binary_sensor присутствия из HA_TELEMETRY_ENTITIES.
# on=дома, off=вне дома; не используйте обычный датчик движения. Пусто = выключено.
ANALYTICS_PRESENCE_ENTITY=
ANALYTICS_TIMEZONE=Asia/Yekaterinburg
ANALYTICS_INTERVAL_SECONDS=3600

# TASK-21: цели только для явно подтверждённых предложений; default пусто.
AUTOMATION_ALLOWED_LIGHTS=[]
SUGGESTIONS_INTERVAL_SECONDS=30

# TASK-22: выключено; источники/свет выбирает пользователь, смена требует нового accept.
AUTOMATION_EXECUTION_ENABLED=false
AUTOMATION_HOME_PRESENCE_ENTITY=
AUTOMATION_CANCEL_SECONDS=30
AUTOMATION_COOLDOWN_SECONDS=1800

# TASK-23: URL коллекции по локальному IP, пустой — без синхронизации.
CALENDAR_URL=
CALENDAR_USERNAME=
CALENDAR_PASSWORD=
CALENDAR_TIMEZONE=Asia/Yekaterinburg
CALENDAR_INTERVAL_SECONDS=300
CALENDAR_TIMEOUT_SECONDS=10

# TASK-24: отдельный opt-in Android, общий календарный текст не отправляется в уведомления.
CALENDAR_REMINDERS_ENABLED=false
CALENDAR_REMINDER_LEAD_MINUTES=10

# TASK-24: только выделенные пользователем DND switch.*, подтверждение отдельно для события.
MEETING_MODE_ENABLED=false
MEETING_MODE_ALLOWED_SWITCHES=[]

# Голос25: локальный WAV/STT; разрешения не наследуются от автоматики.
VOICE_ENABLED=false
VOICE_TARGETS={}
VOICE_MODEL_PATH=
VOICE_MODEL_MANIFEST_SHA256=
VOICE_MEMORY_LIMIT_MB=768
VOICE_TIMEOUT_SECONDS=30

# TASK-26: только локальный адаптер Shade Keypad -> Core -> HA, default-off.
# Встроенные PIN-слоты замка не программируются. Отдельный случайный токен >=32 знаков.
ACCESS_ENABLED=false
ACCESS_ALLOWED_LOCKS=[]
ACCESS_KEYPAD_TOKEN=
