# Shade Core — шаблон. python -m app.setup создаст .env с локальным ключом и правами 600.
SHADE_API_KEY=
DB_URL=sqlite+aiosqlite:///./shade.db

# Уведомления: хранение 1..365 дней; список доверенных служебных приложений (JSON).
NOTIFICATION_RETENTION_DAYS=30
NOTIFICATION_ALLOWED_APPS=["ru.ozon.app.android","com.wildberries.ru","ru.yandex.taxi"]

# Home Assistant
HA_BASE_URL=http://127.0.0.1:8123
HA_TOKEN=
HA_TIMEOUT_SECONDS=5

# Журнал команд и локальные служебные логи (без параметров/текстов).
EVENT_RETENTION_DAYS=90
LOG_DIR=./logs
LOG_MAX_BYTES=1048576
LOG_BACKUP_COUNT=3

# Локальная LLM (путь к GGUF, скачивается через scripts/download_model.sh)
LLM_MODEL_PATH=./models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf

# Телеметрия HA: пустой список отключает сбор. Только числовые sensor и binary_sensor.
# Например: ["sensor.room_temperature","binary_sensor.hall_motion"]
HA_TELEMETRY_ENTITIES=[]
SENSOR_RETENTION_DAYS=90
SENSOR_HISTORY_MAX_ROWS=100000
